rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(gid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(gid)).data.memberIds;
    }

    // 플레이어 프로필: 누구나 읽기(랭킹·구경), 본인만 쓰기
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 12;
    }

    match /guilds/{gid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16;

      // 길드원은 자유롭게 수정(출석·기부·탈퇴), 비회원은 자기 자신을 추가하는 것만 가능
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 10
        )
      );

      match /messages/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200;
      }

      match /raids/{day} {
        allow read, write: if isMember(gid);
      }

      // 문파 창고: 길드원이면 넣고 꺼낼 수 있다. 넣은 사람은 본인으로 기록된다.
      match /stash/{sid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['equip', 'acc']
          && request.resource.data.grade is int
          && request.resource.data.grade >= 0
          && request.resource.data.grade <= 5;
        allow delete: if isMember(gid);
      }
    }
  }
}

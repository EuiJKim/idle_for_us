rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 운영자 한 사람. 이 값이 맞는지는 **여기(서버)에서** 본다 —
    // 화면 쪽에 같은 값이 적혀 있지만 그건 '버튼을 보여 줄까'일 뿐이다.
    function isAdmin() {
      return signedIn() && request.auth.uid == 'hUNkOEQQ6XgSb94Ih6PP2sMEkTl2';
    }

    function isMember(gid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(gid)).data.memberIds;
    }

    // v309 규칙 판 표 — 앱이 rulesv/{판}을 읽어 본다. 지금 판만 읽히고 옛 판은 거부된다(없는 문서라 읽혀도 비어 있다).
    //   규칙을 고치면 여기 숫자와 js/net.js의 RULES_VER를 같이 올린다 → 게시를 잊으면 운영자에게 '다시 게시' 알림.
    match /rulesv/{v} {
      allow get: if signedIn() && v == '486';
    }

    // 플레이어 프로필: 누구나 읽기(랭킹·구경), 본인만 쓰기
    match /players/{uid} {
      allow read: if signedIn();
      // v268: 올릴 수 있는 칸을 못박는다(아무 칸이나 큰 값을 넣어 저장 공간·서열을 어지럽히지 못하게).
      //   옛 판이 남긴 칸이 있는 문서도 있으니, 고칠 때는 '이번에 바뀐 칸'만 본다.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(profileKeys()) && profileOk();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys()) && profileOk();
      // v282 운영자는 서열 문서를 지울 수 있다(테스트·버려진 계정 정리)
      allow delete: if isAdmin();
    }
    function profileKeys() {
      return ['world', 'nickname', 'level', 'job', 'jobTier', 'tierName', 'map', 'mapName', 'power', 'atk', 'hp',
        'weaponGrade', 'titles', 'title', 'raidDps', 'guildId', 'guildName', 'updatedAt', 'pvp', 'pvpScore'];   // v451 대결 기록
    }
    function strOk(d, k, n) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n); }
    function numOk(d, k, lo, hi) { return !(k in d) || d[k] == null || (d[k] is number && d[k] >= lo && d[k] <= hi); }
    function profileOk() {
      let d = request.resource.data;
      return d.nickname is string && d.nickname.size() <= 12
        && numOk(d, 'world', 0, 1)
        && (!('level' in d) || (d.level is int && d.level >= 0 && d.level <= 300))
        && (!('jobTier' in d) || (d.jobTier is int && d.jobTier >= 0 && d.jobTier <= 9))   // v415 5차(v391)가 막혀 온라인이 꺼졌다 — 여유 있게 9까지
        && strOk(d, 'job', 16) && strOk(d, 'tierName', 24) && strOk(d, 'mapName', 24) && strOk(d, 'guildName', 16) && strOk(d, 'title', 20)
        && numOk(d, 'map', 0, 1000) && numOk(d, 'weaponGrade', -1, 50)
        && strOk(d, 'pvp', 3000) && numOk(d, 'pvpScore', 0, 99999)
        && numOk(d, 'power', 0, 1000000000000000000000000000000.0) && numOk(d, 'atk', 0, 1000000000000000000000000000000.0) && numOk(d, 'hp', 0, 1000000000000000000000000000000.0) && numOk(d, 'raidDps', 0, 1000000000000000000000000000000.0)
        && (!('titles' in d) || (d.titles is list && d.titles.size() <= 40))
        && (!('guildId' in d) || d.guildId == null || (d.guildId is string && d.guildId.size() <= 8))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // 서버 세이브 (v265) — Google을 이은 계정만 올린다. 본인만 읽고 쓴다(지우기는 없다).
    //   data: 세이브 JSON 글자 · at: 올린 때(ms) · dev: 올린 기기 · lv: 레벨 · build: 판
    match /saves/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'at', 'dev', 'lv', 'build', 'slot'])
        && (!('slot' in request.resource.data) || (request.resource.data.slot is int && request.resource.data.slot >= 0 && request.resource.data.slot <= 3))
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.at is int
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 32
        && request.resource.data.lv is int
        && request.resource.data.build is string && request.resource.data.build.size() <= 32;
      // v328 쉬는 캐릭터(칸 0~3) — 본인만 읽고 쓰고 지운다
      // v349 계정 창고 — 본인만
      match /vault/{doc} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && doc == 'main'
          && request.resource.data.keys().hasOnly(['data', 'at'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 300000
          && request.resource.data.at is int;
      }
      match /chars/{slot} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && slot in ['0', '1', '2', '3']
          && request.resource.data.keys().hasOnly(['data', 'at', 'lv', 'n', 'job'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && request.resource.data.at is int && request.resource.data.lv is int
          && request.resource.data.n is string && request.resource.data.n.size() <= 16
          && request.resource.data.job is string && request.resource.data.job.size() <= 16;
      }
    }

    // 광고 제거 — **플레이어는 못 쓴다.** 자기 것만 읽을 수 있다.
    //
    // players/{uid}에 두면 안 된다. 거기는 본인이 자유롭게 쓰므로 누구나
    // 스스로 켤 수 있다. 쓰기 규칙을 아예 안 쓰면 콘솔(운영자)만 쓸 수 있다.
    //
    // 운영자가 하는 일: 입금 확인 → 이 경로에 문서 하나 만들기
    //   entitlements/{그 사람 uid}  ->  { noAds: true }
    match /entitlements/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 켜고 끄는 건 운영자만. 담을 수 있는 것도 noAds 하나로 못박는다 —
      // 나중에 다른 걸 끼워 넣고 싶어지면 규칙부터 고치게 된다.
      allow create, update: if isAdmin()
        && request.resource.data.noAds is bool
        && request.resource.data.keys().hasOnly(['noAds', 'at', 'memo']);
      allow delete: if isAdmin();
    }

    // 운영자 선물 (v175) — 운영자가 넣고, 받는 사람이 받으면서 지운다
    match /gifts/{uid}/box/{gid} {
      allow read, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['gold', 'potions', 'prot', 'pet', 'mount', 'title', 'memo', 'at'])
        && (!('pet' in request.resource.data) || (request.resource.data.pet is string && request.resource.data.pet.size() <= 20))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 20))
        && (!('mount' in request.resource.data) || (request.resource.data.mount is string && request.resource.data.mount.size() <= 20))
        && (!('gold' in request.resource.data) || (request.resource.data.gold is int && request.resource.data.gold > 0 && request.resource.data.gold <= 1000000000000))
        && (!('potions' in request.resource.data) || (request.resource.data.potions is int && request.resource.data.potions > 0 && request.resource.data.potions <= 100000))
        && (!('prot' in request.resource.data) || (request.resource.data.prot is int && request.resource.data.prot > 0 && request.resource.data.prot <= 10000));
    }

    // 상점에 띄울 계좌 정보. **저장소에 안 둔다** — 공개 저장소라서다.
    // 운영자가 콘솔에서 고치면 바로 반영된다(배포가 필요 없다).
    //   config/shop  ->  { bank: '○○은행 000-0000-0000 홍길동', price: '5,000원', note: '...' }
    // v302 전체 채팅 — 로그인한 사람은 누구나 읽고 쓴다. 자기 이름으로만 · 200자 · 시각은 서버 시각. 고치기·지우기는 운영자만.
    // v316 주간 두목 순위(v409 각성 마귀 awk 더함) — 주(월요일, 'YYYY-MM-DD')마다 한 사람 문서 하나. 처치 수는 줄지 않고, 최단 초는 늘지 않는다.
    // v432 지난주 두목 순위 보상 — 계정마다 주에 한 번(만들기만)
    match /wbclaim/{uid}/w/{wk} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && wk.size() == 10
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }
    match /wboss/{wk}/p/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && wk.size() == 10
        && request.resource.data.keys().hasOnly(['name', 'title', 'kills', 'hwamugi', 'magwi', 'awk', 'lv', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && strOk(request.resource.data, 'title', 16)
        && request.resource.data.kills is int && request.resource.data.kills >= 0 && request.resource.data.kills <= 100000
        && numOk(request.resource.data, 'hwamugi', 3, 36000)
        && numOk(request.resource.data, 'magwi', 3, 36000)
        && numOk(request.resource.data, 'awk', 3, 36000)
        && request.resource.data.lv is int && request.resource.data.lv >= 0 && request.resource.data.lv <= 300
        && request.resource.data.at == request.time
        && (resource == null || (
          request.resource.data.kills >= resource.data.kills
          // v476 처치 수는 지난번 올린 때부터 흐른 시간만큼만(두목 하나 3초 · 여유 5) — 한 번에 큰 수를 올리지 못하게
          && request.resource.data.kills <= resource.data.kills + 5 + (request.time.toMillis() - resource.data.at.toMillis()) / 3000
          && (!('hwamugi' in resource.data) || request.resource.data.hwamugi <= resource.data.hwamugi)
          && (!('magwi' in resource.data) || request.resource.data.magwi <= resource.data.magwi)
          && (!('awk' in resource.data) || request.resource.data.awk <= resource.data.awk)));
      allow delete: if isAdmin();
    }
    // v373 월드보스 · v375 팔마왕(상시 최종 두목)·옥황상제 — 마왕마다 wbp/{마왕} = {seq}(지금 몇 번째)와 wraid/{마왕}_{seq}(그 마왕의 체력).
    //   세우기: 첫째(seq 1)는 누구나 · 다음(seq+1)은 지금 마왕이 쓰러졌을 때만 — 두 문서를 한 번에(batch) 쓴다.
    //   칠 땐 자기 피해만 늘리고 그만큼만 합계 · 마무리면 killedAt·killer(자기) · 쓰러진 뒤 친 사람만 자기 받음 표시. 지우기는 운영자만.
    function wbBoss(b) { return b in ['umawang', 'gyomawang', 'bungmawang', 'satawang', 'mihuwang', 'uyungwang', 'sonogong', 'sadae', 'takap', 'nata', 'irang', 'okhwang', 'seokga']; }
    // v432 마왕 체력 배수(관문 ×3 · 옥황상제 ×8 · 석가여래 ×24) — 아무나 약한 마왕(체력 100만)을 세워 1위·마무리를 먹지 못하게
    //   기준(마왕 하나)은 화무기 체력 × WRAID_HP_K ≈ 7.7조. 균형을 손볼 여유로 0.4배~4배만 받는다(tests/world.mjs가 범위를 지킨다)
    function wbHpK(b) { return b == 'seokga' ? 24 : (b == 'okhwang' ? 8 : (b in ['sadae', 'takap', 'nata', 'irang'] ? 3 : 1)); }
    match /wbp/{boss} {
      allow read: if signedIn();
      allow create: if signedIn() && wbBoss(boss)
        && request.resource.data.keys().hasOnly(['seq']) && request.resource.data.seq == 1
        && existsAfter(/databases/$(database)/documents/wraid/$(boss + '_1'));
      allow update: if signedIn() && wbBoss(boss)
        && request.resource.data.keys().hasOnly(['seq']) && request.resource.data.seq == resource.data.seq + 1
        && get(/databases/$(database)/documents/wraid/$(boss + '_' + string(resource.data.seq))).data.total
           >= get(/databases/$(database)/documents/wraid/$(boss + '_' + string(resource.data.seq))).data.maxHp
        && existsAfter(/databases/$(database)/documents/wraid/$(boss + '_' + string(request.resource.data.seq)));
      allow delete: if isAdmin();
    }
    match /wraid/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['boss', 'seq', 'maxHp', 'total', 'damage', 'names', 'claimed', 'killedAt', 'killer', 'createdAt'])
        && request.resource.data.boss is string && wbBoss(request.resource.data.boss)
        && request.resource.data.seq is int && request.resource.data.seq >= 1
        && id == request.resource.data.boss + '_' + string(request.resource.data.seq)
        && getAfter(/databases/$(database)/documents/wbp/$(request.resource.data.boss)).data.seq == request.resource.data.seq
        && request.resource.data.maxHp is number && request.resource.data.maxHp >= 3000000000000.0 * wbHpK(request.resource.data.boss) && request.resource.data.maxHp <= 30000000000000.0 * wbHpK(request.resource.data.boss)
        && request.resource.data.total == 0
        && request.resource.data.damage == {} && request.resource.data.names == {} && request.resource.data.claimed == {}
        && request.resource.data.killedAt == null && request.resource.data.killer == null
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (wHit() || wSeen() || wLate() || wClaim());
      allow delete: if isAdmin();

      function wChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function wDelta() {
        return request.resource.data.damage.get(request.auth.uid, 0) - resource.data.damage.get(request.auth.uid, 0);
      }
      function wHit() {
        return wChanged().hasOnly(['total', 'damage', 'names', 'killedAt', 'killer'])
          && resource.data.total < resource.data.maxHp
          && request.resource.data.damage.diff(resource.data.damage).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names.get(request.auth.uid, '') is string
          && request.resource.data.names.get(request.auth.uid, '').size() <= 12
          && wDelta() > 0
          && request.resource.data.total > resource.data.total
          && request.resource.data.total - resource.data.total <= wDelta()
          && request.resource.data.total <= resource.data.maxHp
          && (request.resource.data.total < resource.data.maxHp
            ? (!('killedAt' in wChanged()) && !('killer' in wChanged()))
            : (request.resource.data.killedAt == request.time && request.resource.data.killer == request.auth.uid));
      }
      // v417 늦은 한 몫 — 같이 치던 중 다른 무인이 마무리해 내 마지막 몫(4초마다 올린다)이 못 올라간 경우.
      //   쓰러진 뒤 3분 안 · 아직 내 피해가 0일 때만 · 체력의 5%까지(순위를 사지 못하게) · 합계·마무리는 그대로
      // v421 들어왔다는 표시 — 살아 있을 때 내 칸(seen)에 지금 시각만. 늦은 한 몫(wLate)은 이 표시가 있는 사람만(안 치고 3분 안에 올려 순위 보상을 받던 구멍)
      function wSeen() {
        return wChanged().hasOnly(['seen'])
          && resource.data.total < resource.data.maxHp
          && request.resource.data.seen.diff(resource.data.get('seen', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.seen[request.auth.uid] == request.time;
      }
      function wLate() {
        return wChanged().hasOnly(['damage', 'names'])
          && resource.data.total >= resource.data.maxHp
          && request.auth.uid in resource.data.get('seen', {})
          && resource.data.killedAt != null && request.time < resource.data.killedAt + duration.value(3, 'm')
          && resource.data.damage.get(request.auth.uid, 0) == 0
          && request.resource.data.damage.diff(resource.data.damage).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names.get(request.auth.uid, '') is string
          && request.resource.data.names.get(request.auth.uid, '').size() <= 12
          && wDelta() > 0 && wDelta() <= resource.data.maxHp * 0.05;
      }
      function wClaim() {
        return wChanged().hasOnly(['claimed'])
          && resource.data.total >= resource.data.maxHp
          && resource.data.damage.get(request.auth.uid, 0) > 0
          && request.resource.data.claimed.diff(resource.data.claimed).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.claimed[request.auth.uid] == true;
      }
    }
    // v436 버그 신고 — 누구나 자기 이름으로 하나씩(손으로 · 오류 저절로) · 운영자만 읽고 지운다. 문서 하나 1MB 안
    match /bugs/{bid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'kind', 'text', 'build', 'ua', 'lv', 'map', 'save', 'notes', 'errs', 'shot', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.kind in ['user', 'auto']
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.build is string && request.resource.data.build.size() <= 24
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 240
        && request.resource.data.lv is int && request.resource.data.map is int
        && request.resource.data.save is string && request.resource.data.save.size() <= 600000
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 20000
        && request.resource.data.errs is string && request.resource.data.errs.size() <= 12000
        && request.resource.data.shot is string && request.resource.data.shot.size() <= 250000
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // v321 신고 — 누구나 남의 말 하나를 신고 · 운영자만 읽고 지운다
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'uid', 'name', 'text', 'mid', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128 && request.resource.data.uid != request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && request.resource.data.mid is string && request.resource.data.mid.size() <= 64
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // v321 입막음 — 운영자만 쓴다 · 누구나 읽는다(자기가 막혔는지 본다)
    match /mutes/{uid} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['until', 'by', 'reason', 'name'])
        && request.resource.data.until is timestamp;
      allow delete: if isAdmin();
    }
    // v315 전체 채팅 빠르기 막이 — 한 사람 문서 하나, at은 늘 '지금'이고 앞 값보다 2초 넘게 뒤여야 한다
    match /chatlimit/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && (resource == null || request.time > resource.data.at + duration.value(2, 's'));
      allow delete: if false;
    }
    match /chat/{mid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'type', 'createdAt', 'title'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= (request.resource.data.type == 'chat' ? 100 : 200)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 12
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 16))
        && request.resource.data.type in ['chat', 'system']
        && request.resource.data.createdAt == request.time
        // v315 2초에 하나 — 같은 묶음에서 chatlimit/{uid}.at을 지금으로 바꿔야 한다(그 문서는 2초가 지나야 바뀐다)
        && getAfter(/databases/$(database)/documents/chatlimit/$(request.auth.uid)).data.at == request.time
        // v321 입막음 — 운영자가 막은 동안은 말하지 못한다
        && (!exists(/databases/$(database)/documents/mutes/$(request.auth.uid))
          || get(/databases/$(database)/documents/mutes/$(request.auth.uid)).data.until < request.time);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── v486 새 시즌(s2) — 옛 시즌 문서와 따로 쓴다(교체 뒤 옛 서열은 명예의 전당으로) ──
    // 서열 문서: 칸을 못박고(js/s2/online/rank.js PROFILE_KEYS와 같다 — 시험이 맞춰 본다), 값은 있을 수 있는 범위만.
    function s2Keys() {
      return ['season', 'nickname', 'lv', 'job', 'power', 'pvpPower', 'pvpScore', 'wbScore', 'guildId', 'tv', 'signed', 'updatedAt'];
    }
    function s2Ok() {
      let d = request.resource.data;
      return d.season == 's2' && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 12
        && d.lv is int && d.lv >= 1 && d.lv <= 150
        && strOk(d, 'job', 16) && strOk(d, 'tv', 16)
        && numOk(d, 'power', 0, 1000000000000000000000000000000.0) && numOk(d, 'pvpPower', 0, 1000000000000000000000000000000.0)
        && (!('pvpScore' in d) || (d.pvpScore is int && d.pvpScore >= 0 && d.pvpScore <= 99999))
        && numOk(d, 'wbScore', 0, 1000000000000.0)
        && (!('guildId' in d) || d.guildId == null || (d.guildId is string && d.guildId.size() <= 8))
        && (!('signed' in d) || d.signed is bool)
        && d.updatedAt == request.time;
    }
    match /s2_players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(s2Keys()) && s2Ok();
      // 레벨은 줄지 않는다
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(s2Keys()) && s2Ok()
        && request.resource.data.lv >= resource.data.lv;
      allow delete: if isAdmin();
    }
    // 월드보스 주간 점수 — 한 번 칠 때마다 횟수 +1 · 점수는 그만큼만(한 번 상한) · 하루 3번 × 7일
    match /s2_wboss/{wk}/p/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && wk.size() == 10
        && request.resource.data.keys().hasOnly(['name', 'score', 'tries', 'best', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.tries is int && request.resource.data.tries >= 1 && request.resource.data.tries <= 21
        && request.resource.data.score is int && request.resource.data.best is int
        && request.resource.data.best >= 0 && request.resource.data.best <= 5000000
        && request.resource.data.at == request.time
        && (resource == null
          ? (request.resource.data.tries == 1 && request.resource.data.score == request.resource.data.best)
          : (request.resource.data.tries == resource.data.tries + 1
            && request.resource.data.score - resource.data.score >= 0
            && request.resource.data.score - resource.data.score <= 5000000
            && request.resource.data.best >= resource.data.best
            // 한 번 칠 때 90초 — 지난번 올린 때부터 적어도 60초
            && request.time.toMillis() - resource.data.at.toMillis() >= 60000));
      allow delete: if isAdmin();
    }
    // 대결 방어 덱 — 본인만 · 덱 글자 3000자 · 점수 범위
    match /s2_pvp/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'deck', 'score', 'lv', 'at'])
        && request.resource.data.deck is string && request.resource.data.deck.size() <= 3000
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 99999
        && request.resource.data.lv is int && request.resource.data.lv >= 1 && request.resource.data.lv <= 150
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
      // 공격 기록 — 공격한 사람이 상대 우편함에 남김(상대가 들어오면 점수에 반영). 남의 이름으로는 못 씀 · 점수 변화 범위
      match /log/{lid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['by', 'name', 'win', 'd', 'seed', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.win is bool
          && request.resource.data.d is int && request.resource.data.d >= -20 && request.resource.data.d <= 3
          && request.resource.data.seed is int
          && request.resource.data.at == request.time;
      }
    }
    // 문파 새 시즌 콘텐츠(토벌·대항·수련·연구·도움) — 문파원만 읽고 쓴다(값 검사는 점검 작업이)
    match /guilds/{gid}/s2/{doc} {
      allow read: if isMember(gid);
      allow create, update: if isMember(gid) && doc in ['raid', 'war', 'train', 'research', 'help']
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 20000
        && request.resource.data.at == request.time;
    }
    // 명예의 전당 — 운영자(교체 작업)만 쓴다 · 누구나 읽는다
    match /fame/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // v476 서열 점검 결과 — 서버 점검(tools/rankcheck.mjs, 서비스 계정)이 적고 운영자만 읽고 고친다(되살리기 = ok)
    match /flags/{uid} {
      allow read, write: if isAdmin();
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();   // 계좌 정보를 폰에서 고칠 수 있게
    }

    // v339 문파 찾기 목록 — 누구나 읽는다. 쓰기는 그 문파의 문파원만(이름·인원·경험치), 모집 여닫기(open)는 문주만.
    match /guildlist/{gid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/guilds/$(gid)).data.memberIds
        && request.resource.data.keys().hasOnly(['name', 'n', 'exp', 'open', 'at', 'intro', 'minLv'])
        && request.resource.data.get('intro', '') is string && request.resource.data.get('intro', '').size() <= 40
        && request.resource.data.get('minLv', 0) is int && request.resource.data.get('minLv', 0) >= 0 && request.resource.data.get('minLv', 0) <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 10
        && request.resource.data.exp is number
        // 모집 여닫기·소개·가입 레벨(v345)은 문주만 바꾼다
        && ((request.resource.data.get('open', true) == (resource == null ? true : resource.data.get('open', true))
             && request.resource.data.get('intro', '') == (resource == null ? '' : resource.data.get('intro', ''))
             && request.resource.data.get('minLv', 0) == (resource == null ? 0 : resource.data.get('minLv', 0)))
            || get(/databases/$(database)/documents/guilds/$(gid)).data.owner == request.auth.uid);
      allow delete: if signedIn() && get(/databases/$(database)/documents/guilds/$(gid)).data.owner == request.auth.uid;
    }

    match /guilds/{gid} {
      // v257: 문서 하나 읽기(get)만 — 전엔 list도 열려 있어 전체 문파 코드를 훑어 아무 문파에나 들어갈 수 있었다.
      //   문파 코드가 곧 문서 id라, 코드를 아는 사람만 들어온다(함께 사냥 방 gm 표도 코드를 알아야 쓴다).
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'owner', 'memberIds', 'members', 'exp', 'checkins', 'createdAt', 'bank'])
        && request.resource.data.get('exp', 0) == 0
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16;

      // v268 문파원이 바꿀 수 있는 것: 출석(자기 것) · 이름표(자기 것) · 경험치(한 번에 20까지, 줄이기 없음) · 재료 창고 · 나가기(자기만).
      //   문주(owner)·이름·코드는 못 바꾼다. 전엔 문파원이면 아무 칸이나 고쳐 남을 내보내거나 문주를 빼앗을 수 있었다.
      // 들어오기: 문파원이 아니면 자기 자신 한 명만 끝에 붙인다(최대 10명).
      allow update: if signedIn() && (memberUpdate() || joinUpdate());

      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function onlyMine(k) {
        return !(k in changed())
          || request.resource.data.get(k, {}).diff(resource.data.get(k, {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      function memberUpdate() {
        return request.auth.uid in resource.data.memberIds
          && changed().hasOnly(['exp', 'checkins', 'members', 'memberIds', 'bank'])
          && onlyMine('checkins') && onlyMine('members')
          && (!('exp' in changed()) || (request.resource.data.exp is number
                && request.resource.data.exp >= resource.data.get('exp', 0)
                && request.resource.data.exp <= resource.data.get('exp', 0) + 20))
          && (!('memberIds' in changed()) || request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]))
          && (!('bank' in changed()) || request.resource.data.bank is map);
      }
      function joinUpdate() {
        return !(request.auth.uid in resource.data.memberIds)
          && changed().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.memberIds.size() <= 10
          && onlyMine('members')
          && request.resource.data.members[request.auth.uid] is string
          && request.resource.data.members[request.auth.uid].size() <= 12;
      }

      match /messages/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'type', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 12))
          && (!('type' in request.resource.data) || request.resource.data.type in ['chat', 'system']);
      }

      // 토벌 — v268: 만들 땐 빈 상태로, 칠 땐 자기 피해만 늘리고 그만큼만 합계를 올린다. 보상 받음 표시는 쓰러진 뒤 자기 것만.
      match /raids/{day} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.total == 0
          && request.resource.data.damage == {} && request.resource.data.claimed == {}
          && request.resource.data.maxHp is number && request.resource.data.maxHp > 0;
        allow update: if isMember(gid) && raidHit() || isMember(gid) && raidClaim();

        function rChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
        function myDelta() {
          return request.resource.data.damage.get(request.auth.uid, 0) - resource.data.get('damage', {}).get(request.auth.uid, 0);
        }
        function raidHit() {
          return rChanged().hasOnly(['total', 'damage', 'names', 'killedAt'])
            && request.resource.data.maxHp == resource.data.maxHp
            && resource.data.get('total', 0) < resource.data.maxHp
            && request.resource.data.damage.diff(resource.data.get('damage', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid])
            && myDelta() > 0
            && request.resource.data.total > resource.data.get('total', 0)
            && request.resource.data.total - resource.data.get('total', 0) <= myDelta()
            && request.resource.data.total <= resource.data.maxHp;
        }
        function raidClaim() {
          return rChanged().hasOnly(['claimed'])
            && resource.data.get('total', 0) >= resource.data.maxHp
            && resource.data.get('damage', {}).get(request.auth.uid, 0) > 0
            && request.resource.data.claimed.diff(resource.data.get('claimed', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.claimed[request.auth.uid] == true;
        }
      }

      // 문파 창고: 길드원이면 넣고 꺼낼 수 있다. 넣은 사람은 본인으로 기록된다.
      match /stash/{sid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.keys().hasOnly(['kind', 'type', 'slot', 'grade', 'uid', 'name', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['equip', 'acc']
          && request.resource.data.grade is int
          && request.resource.data.grade >= 0
          && request.resource.data.grade <= 5;
        allow delete: if isMember(gid);
      }
    }
  }
}
